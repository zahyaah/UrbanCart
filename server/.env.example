NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://urbancart:urbancart_dev_only@localhost:5433/urbancart

# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-real-random-secret

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173

# SameSite policy for auth cookies. "lax" for same-site dev/prod; "none"
# only if the frontend and API are ever deployed on different registrable
# domains (also requires secure:true, i.e. HTTPS).
COOKIE_SAME_SITE=lax

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

FRONTEND_URL=http://localhost:5173

# Both optional -- absent means catalog caching/shared rate-limit store and
# Sentry error reporting are no-ops. See lib/redis.ts and lib/sentry.ts.
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=
